{
  "name": "@syseven/video-player",
  "version": "0.0.1",
  "description": "video player based on hls.js",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "opt:icons": "svgo ./src/icons/*.svg",
    "build": "pnpm run opt:icons && tsup"
  },
  "dependencies": {
    "@syseven/utils": "workspace:*",
    "eventemitter3": "^5.0.1",
    "hls.js": "1.5.6"
  }
}
