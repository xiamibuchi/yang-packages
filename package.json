{
  "name": "yang-packages",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "description": "base utils and components",
  "author": "ShenYang",
  "license": "MIT",
  "keywords": [],
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "prepare": "husky install",
    "preinstall": "node ./scripts/preinstall.js",
    "clean": "pnpm run clean:dist && pnpm run -r --parallel clean && find . \\( -name 'node_modules' -o -name 'dist' -o -name '.nuxt' -o -name '.output' \\) -type d -exec rm -rf {} +",
    "clean:dist": "rimraf dist",
    "docs:build": "pnpm --filter @syseven/docs build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run -r unit:test && vitest --config ./vitest.config.ts",
    "test:coverage": "vitest run --coverage --config ./vitest.config.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.1",
    "@changesets/cli": "2.27.1",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@commitlint/types": "^20.4.3",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@syseven/constants": "workspace:*",
    "@syseven/hooks": "workspace:*",
    "@syseven/locale": "workspace:*",
    "@syseven/style": "workspace:*",
    "@syseven/utils": "workspace:*",
    "@syseven/video-player": "workspace:*",
    "@syseven/vue-components": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^21.1.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.12.0",
    "@types/react": "^18.2.69",
    "@types/react-dom": "^18.2.22",
    "@unocss/eslint-plugin": "^66.4.2",
    "@vitejs/plugin-vue": "5.1.4",
    "@vitejs/plugin-vue-jsx": "4.0.1",
    "@vitest/coverage-v8": "2.1.4",
    "@vitest/ui": "2.1.4",
    "@vue/shared": "3.5.12",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.9.0",
    "@vueuse/core": "11.2.0",
    "autocannon": "^7.15.0",
    "autoprefixer": "^10.4.21",
    "chalk": "^5.3.0",
    "clinic": "^13.0.0",
    "consola": "^3.2.3",
    "dependency-cruiser": "^16.2.4",
    "dotenv": "^16.4.5",
    "eslint": "^9.34.0",
    "execa": "^8.0.1",
    "fast-glob": "^3.3.2",
    "husky": "9.1.7",
    "jsdom": "24.0.0",
    "less": "^4.2.0",
    "lint-staged": "16.3.2",
    "lodash-es": "^4.17.21",
    "pm2": "^5.3.1",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "5.0.5",
    "rollup": "4.13.0",
    "rollup-plugin-esbuild": "^6.1.1",
    "sass": "1.72.0",
    "svgo": "3.2.0",
    "tailwindcss": "^3.4.1",
    "terser": "5.29.2",
    "tinify": "1.7.1",
    "ts-morph": "27.0.2",
    "tsup": "^8.4.0",
    "tsx": "4.21.0",
    "turbo": "2.3.3",
    "typescript": "5.8.2",
    "vite": "5.3.3",
    "vitest": "1.4.0",
    "vue": "3.5.12",
    "vue-tsc": "3.2.5"
  },
  "lint-staged": {
    "*.{ts,js,vue,tsx,jsx}": [
      "eslint --fix"
    ]
  }
}
